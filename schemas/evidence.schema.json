{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoruilee/oh-my-mcode/schemas/evidence.schema.json",
  "title": "Oh My MiniMax Code evidence record",
  "description": "One captured artifact under <run>/evidence/. Index rows live in evidence/index.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "path", "recorded_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["command", "test", "diff", "log", "other"]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the run directory, usually evidence/<file>."
    },
    "command": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
