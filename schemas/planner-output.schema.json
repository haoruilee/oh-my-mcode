{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haoruilee/oh-my-mcode/schemas/planner-output.schema.json",
  "title": "Oh My MiniMax Code planner output",
  "description": "Structured planner reply for mcode exec --output-schema: tasks[] + acceptance[].",
  "type": "object",
  "additionalProperties": true,
  "required": ["tasks", "acceptance"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["explorer", "planner", "builder", "verifier", "release"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "done", "blocked", "cancelled"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" },
          "allowed_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["test", "build", "diff", "manual", "diagnostic"]
          },
          "command": { "type": "string" },
          "source": { "type": "string", "enum": ["goal", "detected"] }
        }
      }
    }
  }
}
